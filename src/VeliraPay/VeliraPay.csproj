<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>VeliraPay</RootNamespace>
        <AssemblyName>VeliraPay</AssemblyName>
        <Version>0.2.0</Version>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsAotCompatible>true</IsAotCompatible>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>VeliraPay</PackageId>
        <Title>VeliraPay</Title>
        <Authors>VeliraPay</Authors>
        <Company>VeliraPay</Company>
        <Product>VeliraPay</Product>
        <Description>The official .NET library for VeliraPay crypto payments (https://velirapay.com): every endpoint of the v1 API, from charges, invoices, payment links, coupons and payouts to webhook endpoints, API keys, members and the account, and webhook verification, with no dependencies. API reference: https://velirapay.com/docs</Description>
        <Copyright>Copyright (c) 2026 VeliraPay</Copyright>
        <PackageProjectUrl>https://velirapay.com</PackageProjectUrl>
        <RepositoryUrl>https://github.com/VeliraPay/velirapay-dotnet</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageTags>velirapay;crypto;crypto-payments;cryptocurrency;payments;payment-gateway;payment-processing;bitcoin;ethereum;litecoin;solana;usdt;usdc;webhooks;sdk;api-client;dotnet;csharp</PackageTags>
        <PackageReleaseNotes>https://github.com/VeliraPay/velirapay-dotnet/blob/main/CHANGELOG.md</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="VeliraPay.Tests" />
    </ItemGroup>

</Project>
